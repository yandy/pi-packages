{
	"name": "@yandy0725/pi-sandbox",
	"publishConfig": {
		"access": "public"
	},
	"version": "1.8.2",
	"description": "pi coding-agent extension: process-level sandbox (bwrap / landlock / seatbelt / windows-acl) — workspace writable, everything else readable, fail-closed",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/yandy/pi-packages",
		"directory": "pi-sandbox"
	},
	"type": "module",
	"keywords": [
		"pi-package"
	],
	"files": [
		"index.ts",
		"src/",
		"resources/"
	],
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"clean": "rm -rf dist",
		"prepack": "node ../scripts/license.mjs",
		"postpack": "node ../scripts/license.mjs --remove"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.80.2",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@types/node": "^26.6.6",
		"typebox": "^1.4.3",
		"typescript": "~7.0.2",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@deepseek-ai/node-addon-system": "^0.1.2",
		"koffi": "^3.3.7"
	}
}
