{
	"name": "@yandy0725/pi-todo",
	"publishConfig": {
		"access": "public"
	},
	"version": "0.5.1",
	"description": "pi package providing a minimal todo tool with an editor-overhead widget",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/yandy/pi-packages",
		"directory": "pi-todo"
	},
	"type": "module",
	"keywords": [
		"pi-package"
	],
	"files": [
		"index.ts",
		"src/"
	],
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"prepack": "node ../scripts/license.mjs",
		"postpack": "node ../scripts/license.mjs --remove"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.80.2",
		"@earendil-works/pi-tui": ">=0.80.2",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@types/node": "^26.6.6",
		"typebox": "^1.4.6",
		"typescript": "~7.0.2",
		"vitest": "^5.1.0"
	}
}
