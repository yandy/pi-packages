{
	"name": "@yandy0725/pi-checkpoint",
	"publishConfig": {
		"access": "public"
	},
	"version": "0.1.0",
	"description": "Read-only Git checkpoints for tracing workspace changes across complete pi agent runs",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/yandy/pi-packages",
		"directory": "pi-checkpoint"
	},
	"type": "module",
	"keywords": [
		"pi-package",
		"git",
		"checkpoints"
	],
	"files": [
		"index.ts",
		"src/"
	],
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"prepack": "node ../scripts/license.mjs",
		"postpack": "node ../scripts/license.mjs --remove"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.5.0",
		"@earendil-works/pi-tui": ">=1.5.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@earendil-works/pi-coding-agent": "1.5.2",
		"@earendil-works/pi-tui": "1.5.2",
		"@types/node": "^26.6.6",
		"typescript": "~7.0.2",
		"vitest": "^5.1.1"
	}
}
