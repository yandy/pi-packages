{
	"name": "@yandy0725/pi-coding-tools",
	"publishConfig": {
		"access": "public"
	},
	"version": "0.8.0",
	"description": "pi package providing AST/LSP code-intelligence tools",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/yandy/pi-packages",
		"directory": "pi-coding-tools"
	},
	"type": "module",
	"keywords": [
		"pi-package"
	],
	"files": [
		"index.ts",
		"src/"
	],
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"format": "biome format --write ."
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.80.2",
		"@earendil-works/pi-ai": ">=0.80.2",
		"typebox": "*"
	},
	"dependencies": {
		"@ast-grep/cli": "^0.51.0",
		"vscode-jsonrpc": "^10.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@types/node": "^26.6.5",
		"typebox": "^1.4.3",
		"typescript": "~7.0.2",
		"vitest": "^5.0.5"
	}
}
