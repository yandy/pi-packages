{
	"name": "pi-packages",
	"private": true,
	"workspaces": [
		"pi-ask-user",
		"pi-coding-tools",
		"pi-container-sandbox",
		"pi-web-tools",
		"pi-todo",
		"pi-memory",
		"pi-vision-tools",
		"pi-lark",
		"pi-dingtalk",
		"pi-sandbox",
		"pi-subagents",
		"pi-superpowers"
	],
	"scripts": {
		"test": "npm run test --workspaces --if-present",
		"test:windows": "npm test -w pi-ask-user -w pi-coding-tools -w pi-memory -w pi-sandbox -w pi-subagents -w pi-todo -w pi-vision-tools -w pi-web-tools",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"lint": "npm run lint --workspaces --if-present",
		"format": "npm run format --workspaces --if-present",
		"check:dev-deps": "node scripts/check-dev-deps.mjs",
		"check:host-deps": "node scripts/check-host-deps.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"typescript": "~7.0.2",
		"@types/node": "^26.6.3",
		"vitest": "^5.0.2"
	}
}
